{
  "name": "@liangai/pulpo-core",
  "version": "0.1.0",
  "type": "module",
  "description": "pulpo core daemon — ACP kernel, capability descriptors, session graph, read-through layer, delivery ladder and delegation broker for multi-channel coding agents.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "pulpo-core": "./bin/pulpo-core"
  },
  "files": [
    "dist",
    "bin",
    "PROTOCOL.md",
    "README.md"
  ],
  "keywords": [
    "acp",
    "agent-client-protocol",
    "mcp",
    "agent",
    "orchestration",
    "daemon",
    "json-rpc",
    "pulpo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Liang-HZ/pulpo",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Liang-HZ/pulpo#readme",
  "bugs": {
    "url": "https://github.com/Liang-HZ/pulpo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/ws": "^8.5.14",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
