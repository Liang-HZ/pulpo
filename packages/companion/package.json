{
  "name": "@pulpo/companion",
  "version": "0.1.0",
  "type": "module",
  "description": "pulpo companion — stdio MCP server injected into agent sessions, exposing cross-channel delegation (delegate_to_agent / send_input / get_task / cancel_task) and list_agents.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "pulpo-companion": "./bin/pulpo-companion"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "acp",
    "agent",
    "delegation",
    "orchestration",
    "pulpo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Liang-HZ/pulpo",
    "directory": "packages/companion"
  },
  "homepage": "https://github.com/Liang-HZ/pulpo#readme",
  "bugs": {
    "url": "https://github.com/Liang-HZ/pulpo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@pulpo/core": "workspace:*",
    "@types/node": "^22.13.1",
    "@types/ws": "^8.5.14",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
